---
import CookieCard from './CookieCard.astro';
import { cookies } from '../data/cookies';

const featuredIds = ['choco-chip', 'red-velvet', 'nutella'];
const featured = featuredIds.map((id) => cookies.find((c) => c.id === id)!);
---

<section class="featured">
	<div class="wrap">
		<div class="head">
			<h2>Las <em>favoritas</em> de la uni</h2>
			<p>Tres galletas que no fallan. ¿Quieres ver todo el menú?</p>
		</div>
		<div class="grid">
			{featured.map((c) => <CookieCard cookie={c} />)}
		</div>
		<div class="more">
			<a href="/catalogo" class="btn btn-ghost">Ver todo el catálogo</a>
			<a href="/armar-pack" class="btn btn-primary">Armar mi pack</a>
		</div>
	</div>
</section>

<style>
	.featured {
		background: #fff;
		padding: 5rem 0;
		border-radius: 48px 48px 0 0;
	}
	.head {
		text-align: center;
		margin-bottom: 2.5rem;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
	}
	h2 em {
		color: var(--caramel);
	}
	.head p {
		color: var(--choco-soft);
		margin-top: 0.6rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
		gap: 1.5rem;
	}
	.more {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 3rem;
	}
	@media (max-width: 600px) {
		.featured { padding: 3rem 0; border-radius: 32px 32px 0 0; }
		.head { margin-bottom: 1.8rem; }
		.more { margin-top: 2rem; }
		.more .btn { flex: 1 1 100%; text-align: center; }
	}
</style>
