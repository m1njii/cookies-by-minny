---
import { universities, whatsappPhone } from '../data/cookies';
const year = new Date().getFullYear();
const wa = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent('¡Hola! Quisiera hacer una consulta.')}`;
---

<footer class="footer">
	<div class="wrap grid">
		<div>
			<a href={import.meta.env.BASE_URL} class="logo">Cookies<span>by</span>Minny</a>
			<p>Galletas artesanales hechas por estudiantes, con ingredientes de buena calidad.</p>
		</div>
		<div>
			<h4>Explora</h4>
			<ul>
				<li><a href={`${import.meta.env.BASE_URL}/catalogo`}>Catálogo</a></li>
				<li><a href={`${import.meta.env.BASE_URL}/armar-pack`}>Armar pack</a></li>
				<li><a href={`${import.meta.env.BASE_URL}/nosotros`}>Nosotros</a></li>
			</ul>
		</div>
		<div>
			<h4>Entregas en</h4>
			<ul>
				{universities.map((u) => <li>{u}</li>)}
			</ul>
		</div>
		<div>
			<h4>Contacto</h4>
			<ul>
				<li><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
				<li><a href="https://www.instagram.com/minnysbakery/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
			</ul>
		</div>
	</div>
	<div class="wrap copy">© {year} CookiesByMinny. Hecho con 🍪 y mucho cariño.</div>
</footer>

<style>
	.footer {
		background: var(--choco);
		color: var(--cream);
		padding: 3.5rem 0 1.5rem;
		margin-top: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr 1fr;
		gap: 2rem;
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.4rem;
		text-decoration: none;
	}
	.logo span {
		color: var(--caramel);
		font-style: italic;
		padding: 0 0.1em;
	}
	p {
		margin-top: 0.6rem;
		opacity: 0.75;
		max-width: 22rem;
		font-size: 0.95rem;
	}
	h4 {
		font-family: var(--font-body);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--caramel);
		margin-bottom: 0.7rem;
	}
	ul {
		list-style: none;
		display: grid;
		gap: 0.4rem;
		font-size: 0.95rem;
	}
	ul a {
		text-decoration: none;
		opacity: 0.85;
	}
	ul a:hover {
		opacity: 1;
		color: var(--caramel);
	}
	.copy {
		margin-top: 2.5rem;
		padding-top: 1.2rem;
		border-top: 1px solid rgba(255, 248, 238, 0.15);
		font-size: 0.85rem;
		opacity: 0.6;
	}
	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 480px) {
		.footer { padding: 2.5rem 0 1.2rem; }
		.grid { grid-template-columns: 1fr; gap: 1.5rem; }
	}
</style>
