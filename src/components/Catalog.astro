---
import CookieCard from './CookieCard.astro';
import { cookies, categories } from '../data/cookies';
---

<section class="catalog">
	<div class="wrap">
		<div class="filters" role="group" aria-label="Filtrar por categoría">
			{categories.map((c, i) => (
				<button type="button" class:list={['chip', { active: i === 0 }]} data-filter={c} aria-pressed={i === 0}>
					{c}
				</button>
			))}
		</div>

		<div class="catalog-carousel-wrapper">
			<div class="products" id="catalog-products">
				{cookies.map((c) => (
					<div class="product-slide" data-category={c.category} data-name={c.name}>
						<CookieCard cookie={c} />
					</div>
				))}
			</div>

			<div class="mobile-catalog-nav" aria-label="Navegación del catálogo en móvil">
				<button type="button" class="nav-btn prev" id="cat-prev" aria-label="Galleta anterior">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M15 18l-6-6 6-6" />
					</svg>
				</button>

				<div class="nav-status">
					<span class="counter-text">
						Galleta <strong id="cat-current">1</strong> de <strong id="cat-total">{cookies.length}</strong>
					</span>
					<div class="dot-indicators" id="cat-dots" aria-hidden="true"></div>
				</div>

				<button type="button" class="nav-btn next" id="cat-next" aria-label="Siguiente galleta">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 18l6-6-6-6" />
					</svg>
				</button>
			</div>

			<p class="mobile-swipe-hint" aria-hidden="true">
				<span>👈</span> Desliza para descubrir todos los sabores <span>👉</span>
			</p>
		</div>
	</div>
</section>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const container = document.getElementById('catalog-products');
	const slides = Array.from(document.querySelectorAll<HTMLElement>('.product-slide'));
	const prevBtn = document.getElementById('cat-prev') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('cat-next') as HTMLButtonElement | null;
	const currentEl = document.getElementById('cat-current');
	const totalEl = document.getElementById('cat-total');
	const dotsContainer = document.getElementById('cat-dots');

	if (container && slides.length > 0) {
		let visibleSlides: HTMLElement[] = [...slides];
		let activeVisibleIndex = 0;

		const renderDots = () => {
			if (!dotsContainer) return;
			dotsContainer.innerHTML = '';
			visibleSlides.forEach((_, i) => {
				const dot = document.createElement('span');
				dot.className = `mini-dot ${i === activeVisibleIndex ? 'active' : ''}`;
				dotsContainer.appendChild(dot);
			});
		};

		const updateStatus = (index: number) => {
			activeVisibleIndex = Math.max(0, Math.min(index, visibleSlides.length - 1));
			if (currentEl) currentEl.textContent = String(visibleSlides.length > 0 ? activeVisibleIndex + 1 : 0);
			if (totalEl) totalEl.textContent = String(visibleSlides.length);

			const dots = dotsContainer?.querySelectorAll('.mini-dot');
			dots?.forEach((dot, i) => {
				dot.classList.toggle('active', i === activeVisibleIndex);
			});

			if (prevBtn) prevBtn.disabled = activeVisibleIndex === 0;
			if (nextBtn) nextBtn.disabled = activeVisibleIndex >= visibleSlides.length - 1;
		};

		const scrollVisibleIndex = (index: number) => {
			if (index < 0 || index >= visibleSlides.length) return;
			const target = visibleSlides[index];
			const targetLeft = target.offsetLeft - (container.clientWidth - target.clientWidth) / 2;
			container.scrollTo({ left: targetLeft, behavior: 'smooth' });
			updateStatus(index);
		};

		prevBtn?.addEventListener('click', () => scrollVisibleIndex(activeVisibleIndex - 1));
		nextBtn?.addEventListener('click', () => scrollVisibleIndex(activeVisibleIndex + 1));

		chips.forEach((chip) =>
			chip.addEventListener('click', () => {
				const f = chip.dataset.filter;
				chips.forEach((c) => {
					const on = c === chip;
					c.classList.toggle('active', on);
					c.setAttribute('aria-pressed', String(on));
				});

				visibleSlides = slides.filter((slide) => {
					const match = f === 'Todas' || slide.dataset.category === f;
					slide.hidden = !match;
					return match;
				});

				renderDots();
				updateStatus(0);
				container.scrollTo({ left: 0, behavior: 'smooth' });
			}),
		);

		let scrollTimeout: number;
		container.addEventListener(
			'scroll',
			() => {
				clearTimeout(scrollTimeout);
				scrollTimeout = window.setTimeout(() => {
					if (visibleSlides.length === 0) return;
					const containerRect = container.getBoundingClientRect();
					const containerCenter = containerRect.left + containerRect.width / 2;

					let closestIdx = 0;
					let minDiff = Infinity;

					visibleSlides.forEach((slide, i) => {
						const rect = slide.getBoundingClientRect();
						const slideCenter = rect.left + rect.width / 2;
						const diff = Math.abs(containerCenter - slideCenter);
						if (diff < minDiff) {
							minDiff = diff;
							closestIdx = i;
						}
					});

					updateStatus(closestIdx);
				}, 50);
			},
			{ passive: true },
		);

		renderDots();
		updateStatus(0);
	}
</script>

<style>
	.catalog {
		background: #fff;
		padding: 3.5rem 0 5rem;
		border-radius: 48px 48px 0 0;
	}
	.filters {
		display: flex;
		gap: 0.6rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}
	.chip {
		font: inherit;
		font-weight: 700;
		padding: 0.5rem 1.3rem;
		border-radius: 999px;
		border: 2px solid var(--cream-dark);
		background: transparent;
		color: var(--choco);
		cursor: pointer;
		transition: all 0.2s;
	}
	.chip:hover {
		border-color: var(--caramel);
	}
	.chip.active {
		background: var(--choco);
		border-color: var(--choco);
		color: var(--cream);
	}

	.catalog-carousel-wrapper {
		position: relative;
	}
	.products {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
		gap: 1.5rem;
	}
	.product-slide {
		height: 100%;
		display: flex;
		flex-direction: column;
	}
	.product-slide[hidden] {
		display: none !important;
	}
	.product-slide :global(.card) {
		height: 100%;
		flex: 1;
	}

	.mobile-catalog-nav,
	.mobile-swipe-hint {
		display: none;
	}

	@media (max-width: 768px) {
		.catalog {
			padding: 2.5rem 0 3.5rem;
			border-radius: 32px 32px 0 0;
		}
		.filters {
			margin-bottom: 1.5rem;
			gap: 0.5rem;
		}
		.chip {
			padding: 0.45rem 1rem;
			font-size: 0.92rem;
		}

		.products {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			gap: 1.1rem;
			padding: 0.5rem 1rem 1.25rem;
			-webkit-overflow-scrolling: touch;
			scroll-behavior: smooth;
			scrollbar-width: none;
		}
		.products::-webkit-scrollbar {
			display: none;
		}

		.product-slide {
			flex: 0 0 84%;
			max-width: 310px;
			scroll-snap-align: center;
			scroll-snap-stop: always;
		}

		.mobile-catalog-nav {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			margin-top: 1rem;
			padding: 0 0.5rem;
		}

		.nav-btn {
			width: 38px;
			height: 38px;
			border-radius: 50%;
			border: 2px solid var(--cream-dark);
			background: var(--cream);
			color: var(--choco);
			display: grid;
			place-items: center;
			cursor: pointer;
			transition: background 0.2s, transform 0.2s, border-color 0.2s, opacity 0.2s;
		}
		.nav-btn:hover:not(:disabled) {
			background: var(--caramel);
			border-color: var(--caramel);
			color: #fff;
		}
		.nav-btn:active:not(:disabled) {
			transform: scale(0.92);
		}
		.nav-btn:disabled {
			opacity: 0.35;
			cursor: not-allowed;
		}

		.nav-status {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.4rem;
		}
		.counter-text {
			font-size: 0.95rem;
			font-weight: 600;
			color: var(--choco);
		}
		.counter-text strong {
			color: var(--caramel);
			font-family: var(--font-display);
			font-size: 1.15rem;
		}

		.dot-indicators {
			display: flex;
			gap: 5px;
			align-items: center;
		}
		:global(.mini-dot) {
			display: inline-block;
			width: 6px;
			height: 6px;
			border-radius: 999px;
			background: var(--cream-dark);
			transition: all 0.25s ease;
		}
		:global(.mini-dot.active) {
			width: 18px;
			background: var(--caramel);
		}

		.mobile-swipe-hint {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			font-size: 0.82rem;
			color: var(--choco-soft);
			margin-top: 0.8rem;
			text-align: center;
		}
	}
</style>
