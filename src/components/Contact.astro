---
import { whatsappPhone } from '../data/cookies';
const url = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent('¡Hola! Quisiera realizar un pedido de galletas.')}`;
---

<section class="contact">
	<div class="wrap">
		<div class="box">
			<h2>¿Se te antojó? <em>Pide ahora.</em></h2>
			<p>Arma tu pack en un minuto o escríbenos por WhatsApp para pedidos especiales.</p>
			<div class="actions">
				<a href={`${import.meta.env.BASE_URL}/armar-pack`} class="btn btn-wa">Armar mi pack</a>
				<a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Escribir por WhatsApp</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		padding: 4rem 0 5rem;
	}
	.box {
		background: var(--caramel);
		color: var(--choco);
		border-radius: 40px;
		padding: clamp(2rem, 6vw, 4.5rem);
		text-align: center;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
	}
	h2 em {
		color: #fff;
	}
	.box p {
		margin: 0.8rem 0 2rem;
		font-size: 1.1rem;
	}
	.actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn-wa {
		background: var(--choco);
		color: #fff;
	}
	@media (max-width: 600px) {
		.contact { padding: 2.5rem 0 3.5rem; }
		.box { border-radius: 28px; }
		.actions .btn { flex: 1 1 100%; text-align: center; }
	}
</style>
