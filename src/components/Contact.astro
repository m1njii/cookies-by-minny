---
const whatsappNumber = "51999999999"; // Reemplazar con el número real
const defaultMessage = encodeURIComponent("¡Hola! Quisiera realizar un pedido de galletas.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${defaultMessage}`;
---

<section id="contacto" class="contact-section">
	<div class="container">
		<div class="contact-card">
			<h2>¿List@ para disfrutar de unas <span>galletas recién horneadas</span>?</h2>
			<p>Hacemos envíos y pedidos personalizados para eventos, regalos y antojos diarios.</p>
			
			<div class="actions">
				<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
					Pedir por WhatsApp 💬
				</a>
				<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="btn-instagram">
					Síguenos en Instagram 📸
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-section {
		padding: 4rem 1.5rem;
		background: var(--bg-main);
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
	}

	.contact-card {
		background: var(--accent-soft);
		border-radius: 24px;
		padding: 3.5rem 2rem;
		text-align: center;
		border: 1px solid rgba(224, 122, 95, 0.2);
	}

	h2 {
		font-size: 2rem;
		color: var(--text-main);
		margin-bottom: 1rem;
		font-weight: 700;
	}

	h2 span {
		color: var(--accent-primary);
	}

	p {
		color: #6b4d41;
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	.actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-whatsapp {
		background: #25d366;
		color: #ffffff;
		padding: 0.8rem 1.8rem;
		border-radius: 30px;
		text-decoration: none;
		font-weight: 600;
		transition: transform 0.2s;
	}

	.btn-instagram {
		background: var(--text-main);
		color: #ffffff;
		padding: 0.8rem 1.8rem;
		border-radius: 30px;
		text-decoration: none;
		font-weight: 600;
		transition: transform 0.2s;
	}

	.btn-whatsapp:hover, .btn-instagram:hover {
		transform: translateY(-2px);
	}
</style>