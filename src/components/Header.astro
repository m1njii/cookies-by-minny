---
const navLinks = [
	{ name: "Inicio", href: "#inicio" },
	{ name: "Menú", href: "#menu" },
	{ name: "Nosotros", href: "#nosotros" },
	{ name: "Contacto", href: "#contacto" },
];
---

<header class="header">
	<div class="container">
		<a href="/" class="logo">
			CookiesByMinny<span>.</span>
		</a>

		<nav>
			<ul>
				{navLinks.map((link) => (
					<li><a href={link.href}>{link.name}</a></li>
				))}
			</ul>
		</nav>

		<a href="#contacto" class="btn-order">Hacer Pedido 🍪</a>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(255, 252, 248, 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--accent-soft);
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 1.2rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-main);
		text-decoration: none;
	}

	.logo span {
		color: var(--accent-primary);
	}

	nav ul {
		display: flex;
		gap: 2rem;
		list-style: none;
	}

	nav a {
		text-decoration: none;
		color: var(--text-main);
		font-weight: 500;
		transition: color 0.2s;
	}

	nav a:hover {
		color: var(--accent-primary);
	}

	.btn-order {
		background: var(--accent-primary);
		color: #ffffff;
		padding: 0.6rem 1.4rem;
		border-radius: 50px;
		text-decoration: none;
		font-weight: 600;
		transition: transform 0.2s, opacity 0.2s;
	}

	.btn-order:hover {
		opacity: 0.9;
		transform: scale(1.03);
	}
</style>