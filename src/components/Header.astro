---
const { pathname } = Astro.url;
const links = [
	{ name: 'Inicio', href: `${import.meta.env.BASE_URL}` },
	{ name: 'Catálogo', href: `${import.meta.env.BASE_URL}/catalogo` },
	{ name: 'Armar pack', href: `${import.meta.env.BASE_URL}/armar-pack` },
	{ name: 'Nosotros', href: `${import.meta.env.BASE_URL}/nosotros` },
];
const active = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="header" id="site-header">
	<div class="wrap bar">
		<a href={import.meta.env.BASE_URL} class="logo">Cookies<span>by</span>Minny</a>

		<nav id="site-nav" aria-label="Principal">
			<div class="panel">
				<ul>
					{links.map((l, i) => (
						<li style={`--i:${i}`}>
							<a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.name}</a>
						</li>
					))}
					<li class="mobile-cta" style={`--i:${links.length}`}>
						<a href={`${import.meta.env.BASE_URL}/armar-pack`} class="btn btn-primary">Hacer mi pedido</a>
					</li>
				</ul>
			</div>
		</nav>

		<a href={`${import.meta.env.BASE_URL}/armar-pack`} class="btn btn-primary cta">Pedir</a>

		<button type="button" class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav">
			<span></span><span></span><span></span>
		</button>
	</div>
</header>

<script>
	const header = document.getElementById('site-header')!;
	const burger = document.getElementById('burger')!;

	function setOpen(open: boolean) {
		header.classList.toggle('open', open);
		burger.setAttribute('aria-expanded', String(open));
		burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		document.body.classList.toggle('menu-open', open);
	}

	burger.addEventListener('click', () => setOpen(!header.classList.contains('open')));
	header.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
	document.addEventListener('click', (e) => {
		if (!header.contains(e.target as Node)) setOpen(false);
	});
	window.matchMedia('(min-width: 721px)').addEventListener('change', () => setOpen(false));
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 60;
		background: rgba(255, 248, 238, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--cream-dark);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 68px;
		gap: 1rem;
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.4rem;
		text-decoration: none;
	}
	.logo span {
		color: var(--caramel);
		font-style: italic;
		padding: 0 0.1em;
	}
	ul {
		display: flex;
		gap: 2rem;
		list-style: none;
	}
	nav a:not(.btn) {
		text-decoration: none;
		font-weight: 600;
		padding-bottom: 2px;
		border-bottom: 2px solid transparent;
		transition: color 0.2s, border-color 0.2s;
	}
	nav a:not(.btn):hover {
		color: var(--caramel);
	}
	nav a[aria-current='page'] {
		border-color: var(--caramel);
	}
	.cta {
		padding: 0.55rem 1.4rem;
	}
	button.burger,
	nav ul li.mobile-cta {
		display: none !important;
	}

	@media (max-width: 720px) {
		.cta {
			display: none;
		}
		button.burger {
			display: flex !important;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 44px;
			height: 44px;
			padding: 0 11px;
			background: var(--cream-dark);
			border: none;
			border-radius: 14px;
			cursor: pointer;
		}
		.burger span {
			display: block;
			height: 2.5px;
			border-radius: 2px;
			background: var(--choco);
			transition: transform 0.3s ease, opacity 0.2s ease;
		}
		.open .burger span:nth-child(1) {
			transform: translateY(7.5px) rotate(45deg);
		}
		.open .burger span:nth-child(2) {
			opacity: 0;
			transform: scaleX(0);
		}
		.open .burger span:nth-child(3) {
			transform: translateY(-7.5px) rotate(-45deg);
		}

		nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			display: grid;
			grid-template-rows: 0fr;
			background: var(--cream);
			border-bottom: 1px solid var(--cream-dark);
			box-shadow: 0 18px 30px rgba(59, 34, 24, 0.12);
			visibility: hidden;
			transition: grid-template-rows 0.35s ease, visibility 0s linear 0.35s;
		}
		.open nav {
			grid-template-rows: 1fr;
			visibility: visible;
			transition: grid-template-rows 0.35s ease, visibility 0s;
		}
		.panel {
			overflow: hidden;
		}
		ul {
			flex-direction: column;
			gap: 0;
			padding: 0.5rem 1.1rem 1.4rem;
		}
		li {
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.3s ease, transform 0.3s ease;
		}
		.open li {
			opacity: 1;
			transform: none;
			transition-delay: calc(0.08s * var(--i) + 0.1s);
		}
		li:not(.mobile-cta) a {
			display: block;
			padding: 0.9rem 0;
			font-size: 1.15rem;
			border-bottom: 1px solid var(--cream-dark) !important;
		}
		li a[aria-current='page'] {
			color: var(--caramel);
		}
		nav ul li.mobile-cta {
			display: block !important;
			padding-top: 1rem;
		}
		.mobile-cta .btn {
			display: block;
			text-align: center;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		nav,
		li,
		.burger span {
			transition: none !important;
		}
	}
</style>
