---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="CookiesByMinny | Galletas Artesanales">
	<Header />
	
	<main class="hero">
		<div class="hero-content">
			<span class="badge">Horneadas diariamente ✨</span>
			<h1>Galletas artesanales hechas con <span>amor y chocolate real</span>.</h1>
			<p>Descubre combinaciones únicas, texturas suaves por dentro y crujientes por fuera.</p>
			<div class="hero-buttons">
				<a href="#menu" class="btn-primary">Ver Menú</a>
				<a href="#contacto" class="btn-secondary">Pedir por WhatsApp</a>
			</div>
		</div>
	</main>

	<!-- Menú de productos -->
	<Menu />

	<!-- Sección de Contacto -->
	<Contact />
</Layout>

<style>
	.hero {
		max-width: 900px;
		margin: 4rem auto;
		padding: 0 1.5rem;
		text-align: center;
	}

	.badge {
		display: inline-block;
		background: var(--accent-soft);
		color: var(--text-main);
		padding: 0.4rem 1rem;
		border-radius: 20px;
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
	}

	.hero h1 {
		font-size: 3rem;
		line-height: 1.2;
		margin-bottom: 1.5rem;
		font-weight: 700;
	}

	.hero h1 span {
		color: var(--accent-primary);
	}

	.hero p {
		font-size: 1.2rem;
		color: #6b4d41;
		max-width: 600px;
		margin: 0 auto 2.5rem;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.btn-primary {
		background: var(--accent-primary);
		color: #fff;
		padding: 0.8rem 2rem;
		border-radius: 30px;
		text-decoration: none;
		font-weight: 600;
	}

	.btn-secondary {
		background: var(--accent-soft);
		color: var(--text-main);
		padding: 0.8rem 2rem;
		border-radius: 30px;
		text-decoration: none;
		font-weight: 600;
	}
</style>